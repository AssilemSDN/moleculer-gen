{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "outDir": "dist/",
    "rootDir": "src/"
  },
  "include": [
    "src/**/*.ts",
    "src/errors/**/*.js"
  ],
  "exclude": ["node_modules", "dist"]
}