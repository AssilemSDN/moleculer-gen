{
  "name": "moleculer-gen",
  "version": "0.6.0",
  "license": "MIT",
  "description": "A Moleculer.js project generator, to make a simple Moleculer-based microservices template with Docker Compose setup for development environment.",
  "scripts": {
    "prepack": "yarn build",
    "init": "node ./bin/cli.js init",
    "lint": "standard",
    "build": "tsc",
    "test": "yarn build && vitest run",
    "test:unit": "yarn build && vitest run tests/src",
    "test:integration": "yarn build && vitest run tests/integration",
    "test:coverage": "yarn build && vitest run --coverage.enabled --coverage.autoAttachSubprocess --coverage.reportsDirectory=coverage/all",
    "test:unit:coverage": "yarn build && vitest run tests/src --coverage.enabled --coverage.reportsDirectory=coverage/unit",
    "test:integration:coverage": "yarn build && vitest run tests/integration --coverage.enabled --coverage.autoAttachSubprocess --coverage.reportsDirectory=coverage/integration",
    "audit": "yarn npm audit --all --recursive --severity high",
    "audit:prod": "yarn npm audit --all --recursive --environment production --severity high"
  },
  "bin": "./bin/cli.js",
  "files": [
    "bin",
    "src",
    "dist",
    "templates",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "change-case": "5.4.4",
    "commander": "15.0.0",
    "corepack": "0.36.0",
    "inquirer": "14.2.1",
    "js-yaml": "5.4.2",
    "lodash": "4.18.1",
    "log-symbols": "7.0.1",
    "mustache": "4.2.0",
    "pluralize-esm": "9.0.5",
    "slugify": "1.6.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5",
    "standard": "17.1.2",
    "typescript": "7.0.2",
    "vite": "8",
    "vitest": "5"
  },
  "type": "module"
}
