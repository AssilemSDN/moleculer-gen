{
  "name": "moleculer-gen",
  "version": "0.6.0",
  "license": "MIT",
  "description": "A Moleculer.js project generator, to make a simple Moleculer-based microservices template with Docker Compose setup for development environment.",
  "scripts": {
    "prepack": "yarn build",
    "init": "node ./bin/cli.js init",
    "lint": "standard",
    "build": "tsc",
    "test": "yarn build && vitest run --reporter=dot",
    "test:integration": "yarn build && vitest run tests/integration --reporter=dot",
    "audit": "yarn npm audit --all --recursive --severity high",
    "audit:prod": "yarn npm audit --all --recursive --environment production --severity high"
  },
  "bin": "./bin/cli.js",
  "files": [
    "bin",
    "src",
    "dist",
    "templates",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "change-case": "5.4.4",
    "commander": "15.0.0",
    "inquirer": "12.9.6",
    "js-yaml": "5.2.3",
    "lodash": "4.18.1",
    "mustache": "4.2.0",
    "pluralize-esm": "9.0.5",
    "slugify": "1.6.6"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "standard": "17.1.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "type": "module"
}
