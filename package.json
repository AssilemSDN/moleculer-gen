{
  "name": "moleculer-gen",
  "version": "0.6.0",
  "license": "MIT",
  "description": "A Moleculer.js project generator, to make a simple Moleculer-based microservices template with Docker Compose setup for development environment.",
  "scripts": {
    "prepack": "yarn build",
    "init": "node ./bin/cli.js init",
    "lint": "standard",
    "build": "tsc",
    "test": "yarn build && vitest run",
    "test:unit": "yarn build && vitest run tests/src",
    "test:integration": "yarn build && vitest run tests/integration",
    "test:unit:coverage": "yarn build && vitest run tests/src --coverage",
    "test:integration:coverage": "yarn build && c8 --all --src src --include 'src/**/*.js' --exclude 'src/modules/**' --reporter=text --reporter=lcov --reports-dir coverage/integration vitest run tests/integration",
    "audit": "yarn npm audit --all --recursive --severity high",
    "audit:prod": "yarn npm audit --all --recursive --environment production --severity high"
  },
  "bin": "./bin/cli.js",
  "files": [
    "bin",
    "src",
    "dist",
    "templates",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "change-case": "5.4.4",
    "commander": "15.0.0",
    "corepack": "0.36.0",
    "inquirer": "14.2.0",
    "js-yaml": "5.4.1",
    "lodash": "4.18.1",
    "log-symbols": "7.0.1",
    "mustache": "4.2.0",
    "pluralize-esm": "9.0.5",
    "slugify": "1.6.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "c8": "12.0.0",
    "standard": "17.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "type": "module"
}
